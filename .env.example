# polydesk — copy to .env
MODE=paper                 # paper | live
ASSET=btc
STARTING_CASH=1000
MAX_MARKET_NOTIONAL=150
TAKER_MIN_EDGE=0.015
TAKER_MIN_P=0.90
MAKER_ENABLED=1
MAKER_MARGIN=0.03
MAKER_SHARES=50
RESIDUAL_MAX=50
DASHBOARD_PORT=8747

# live only. Export a dedicated hot wallet with a small balance; never the main one.
# POLY_PRIVATE_KEY=
# POLY_FUNDER=            # your Polymarket proxy/funder address
# POLY_SIGNATURE_TYPE=1   # 0 EOA, 1 proxy (Magic/email login), 2 Safe
